# Copy to supabase/functions/.env (gitignored) for local `supabase functions serve`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Required. Server-side only: never put this in the app or behind an EXPO_PUBLIC_ prefix.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Max analyses (photo or text) per user per rolling hour. Default 30.
SCAN_RATE_LIMIT_PER_HOUR=30

# Optional. Claude output_config.effort: low | medium | high | xhigh | max. Default medium.
ANALYZE_EFFORT=medium
