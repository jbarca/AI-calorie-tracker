{
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@0.131.0",
    "@anthropic-ai/sdk/": "npm:/@anthropic-ai/sdk@0.131.0/",
    "@calorie/shared": "../_shared/calorie-shared/index.ts",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/encoding/base64": "jsr:@std/encoding@1.0.11/base64",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.117.2",
    "jimp": "npm:jimp@1.6.1",
    "zod": "npm:zod@4.6.5"
  },
  "nodeModulesDir": "none",
  "tasks": {
    "test": "deno test",
    "check": "deno check *.ts && deno lint",
    "eval": "deno run --allow-env --allow-read=eval --allow-write=eval/results --allow-net=api.anthropic.com eval/run.ts",
    "eval:fetch": "deno run --allow-env --allow-read=eval --allow-write=eval/photos --allow-net=storage.googleapis.com,openfoodfacts-images.s3.eu-west-3.amazonaws.com,raw.githubusercontent.com eval/fetch.ts"
  }
}
