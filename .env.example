# Copy to app/.env (Expo loads .env from the app project root) and fill in.
# Values from `npx supabase status` when running locally, or your Supabase project settings.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: ANTHROPIC_API_KEY is NOT an app variable. Anything prefixed EXPO_PUBLIC_ is bundled
# into the client. Set the Anthropic key only as a Supabase Edge Function secret:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# (for local `supabase functions serve`, put it in supabase/functions/.env, which is gitignored)
